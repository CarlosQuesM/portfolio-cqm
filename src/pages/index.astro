<script>
	// 1. Las frases que vamos a teclear
	const palabras = [
		"Frontend Developer.",
		"Desarrollador Web.",
		"Escribiendo código en TypeScript.",
		"Creador de Soluciones."
	];

	// 2. Variables para llevar la cuenta
	const elementoTexto = document.getElementById('texto-animado');
	let indicePalabra = 0; // ¿En qué palabra de la lista estamos?
	let indiceCaracter = 0; // ¿Por qué letra de esa palabra vamos?
	let borrando = false; // ¿Estamos escribiendo o borrando?

	// 3. La función de la máquina de escribir
	function teclear() {
		if (!elementoTexto) return;

		// Seleccionamos la palabra actual de la lista
		const palabraActual = palabras[indicePalabra];
		
		if (borrando) {
			// Si estamos borrando, recortamos una letra
			elementoTexto.textContent = palabraActual.substring(0, indiceCaracter - 1);
			indiceCaracter--;
		} else {
			// Si estamos escribiendo, añadimos una letra
			elementoTexto.textContent = palabraActual.substring(0, indiceCaracter + 1);
			indiceCaracter++;
		}

		// 4. Velocidad dinámica (teclea normal, pero borra rápido)
		let velocidad = borrando ? 50 : 100;

		// 5. Lógica de pausas
		if (!borrando && indiceCaracter === palabraActual.length) {
			// Si terminó de escribir la palabra entera, pausa de 2 segundos para que se lea
			velocidad = 2000; 
			borrando = true;
		} else if (borrando && indiceCaracter === 0) {
			// Si terminó de borrar todo, pasa a la siguiente palabra y haz una mini pausa
			borrando = false;
			indicePalabra = (indicePalabra + 1) % palabras.length;
			velocidad = 500; 
		}

		// Volvemos a ejecutar la función después del tiempo calculado
		setTimeout(teclear, velocidad);
	}

	// Iniciar la máquina de escribir un segundo después de cargar la página
	setTimeout(teclear, 1000);
</script>