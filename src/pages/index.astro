---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Carlosdev">
	<main class="contenedor-central">
		<div class="contenedor-foto">
			<img src="/src/assets/portf.jpeg" alt="Carlosdev" class="foto-perfil">
		</div>

		<h1>
			¡Hola, soy <span class="texto-verde">Carlos</span>!
		</h1>
		
		<div class="texto-maquina">
			<span id="texto-animado"></span><span class="cursor"></span>
		</div>

		<div class="contenedor-redes">
			
			<a href="https://github.com/CarlosQuesM" target="_blank" class="boton-red" aria-label="GitHub">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
			</a>

			<a href="https://linkedin.com/in/carlosquesadames/" target="_blank" class="boton-red" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
			</a>

		</div>

		<div style="margin-top: 2rem;">
			<a href="/solicitar-cv" class="boton-cv">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				Solicitar CV
			</a>
		</div>

		<a href="#sobre-mi" class="contenedor-scroll" aria-label="Bajar a sobre mí">
			<div class="capsula-scroll">
				<span class="guion-flotante"></span>
			</div>
		</a>

	</main>

	<!-- SECCIÓN: SOBRE MÍ (Diseño Superpuesto) -->
	<section id="sobre-mi" class="seccion-sobre-mi">
		<h1 class="titulo-sobre-mi">Sobre mi</h1>
		
		<div class="grid-sobre-mi">
			
			<!-- Rectángulo Izquierdo: Caja de texto -->
			<div class="caja-texto">
				<p>
					¡Hola! Soy Carlos, un <strong>apasionado del desarrollo web</strong> enfocado en crear interfaces limpias, modernas y altamente funcionales. 
				</p>
				<p>
					Mi viaje en la programación empezó con la curiosidad de saber cómo funcionaba la web por dentro. Hoy en día, disfruto construyendo proyectos escalables y enfrentándome a retos que me hagan salir de mi zona de confort.
				</p>
				<p>
					Cuando no estoy escribiendo código, probablemente me encuentres explorando nuevas tecnologías, leyendo o buscando la taza de café perfecta.
				</p>
			</div>

			<!-- Rectángulo Derecho: Imágenes superpuestas -->
			<div class="contenedor-imagenes">
				<div id="interaccion-fotos" class="grupo-fotos" title="Haz clic para separar las fotos">					<!-- La foto que va al fondo (Asegúrate de tener esta imagen en tu carpeta public) -->
					<img src="/src/assets/img2.jpg" alt="Foto secundaria" class="foto-base foto-detras" />
					
					<!-- La foto principal que va delante -->
					<img src="/src/assets/img1.jpeg" alt="Foto principal de Carlos" class="foto-base foto-delante" />
				</div>
			</div>

		</div>
	</section>

	<script>
		const contenedorFotos = document.getElementById('interaccion-fotos');

		if(contenedorFotos) {
			contenedorFotos.addEventListener('click', function() {
				this.classList.toggle('separadas');
			});
		}

	</script>

