---
// Importamos tu archivo CSS puro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	
	<body>
		<div id="efecto-luz"></div>
		<Navbar />
		<slot />

		<script>
			const luz = document.getElementById('efecto-luz');
			window.addEventListener('mousemove', (event) => {
				const x = event.clientX;
				const y = event.clientY;
				if (luz) {
					luz.style.background = `radial-gradient(100px circle at ${x}px ${y}px, rgba(52, 211, 153, 0.15), transparent 80%)`;
				}
			});
		</script>
	</body>
</html>